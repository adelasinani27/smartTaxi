<core:FragmentDefinition 
    xmlns:core="sap.ui.core" 
    xmlns="sap.m" 
    xmlns:macros="sap.fe.macros"
    xmlns:l="sap.ui.layout"
    xmlns:vbm="sap.ui.vbm">
    
    <VBox id="_IDGenVBox1" class="sapUiSmallMargin">
        
        <!-- Header with ride information -->
        <HBox id="_IDGenHBox1" class="sapUiSmallMarginBottom">
            <Text id="_IDGenText1" text="Ride for" class="sapUiTinyMarginEnd"/>
            <macros:Field id="customTaxiCustomer" readOnly="true" metaPath="CustomerName"/>
            <Text id="_IDGenText2" text="on" class="sapUiTinyMarginBeginEnd"/>
            <macros:Field id="customTaxiDate" readOnly="true" metaPath="LocalCreatedAt"/>
        </HBox>

        <!-- Route information -->
        <HBox id="_IDGenHBox2" class="sapUiSmallMarginBottom">
            <Text id="_IDGenText3" text="From:" class="sapUiSmallMarginEnd"/>
            <macros:Field id="customPickupAddress" readOnly="true" metaPath="PickupAddress"/>
            <Text id="_IDGenText4" text="To:" class="sapUiTinyMarginBeginEnd"/>
            <macros:Field id="customDropoffAddress" readOnly="true" metaPath="DropoffAddress"/>
        </HBox>

        <!-- Map Panel -->
        <Panel id="_IDGenPanel" 
            expandable="true"
            expanded="true"
            headerText="Route Map"
            class="sapUiResponsiveMargin">
            
            <content>
                <VBox id="_IDGenVBox2">
                    
                    <!-- The GeoMap with actual content -->
                    <vbm:AnalyticMap 
                        id="taxiRouteMap" 
                        width="100%" 
                        height="400px"
                        initialPosition="8.6821;50.1109;0"
                        initialZoom="12">
                        
                        <!-- Spots (markers) for the map -->
                        <vbm:vos>
                            <vbm:Spots id="pickupSpots">
                                <vbm:items>
                                    <!-- Pickup location - Green marker -->
                                    <vbm:Spot 
                                        id="pickupSpot"
                                        position="8.6821;50.1109;0"
                                        type="Success"
                                        tooltip="Pickup: Frankfurt Central Station"
                                        icon="sap-icon://customer"/>
                                </vbm:items>
                            </vbm:Spots>
                            
                            <vbm:Spots id="dropoffSpots">
                                <vbm:items>
                                    <!-- Dropoff location - Red marker -->
                                    <vbm:Spot 
                                        id="dropoffSpot"
                                        position="8.5622;50.0334;0"
                                        type="Error"
                                        tooltip="Dropoff: Frankfurt Airport"
                                        icon="sap-icon://flight"/>
                                </vbm:items>
                            </vbm:Spots>
                        </vbm:vos>
                        
                        <!-- Route line connecting pickup and dropoff -->
                        <vbm:Routes id="taxiRoutes">
                            <vbm:items>
                                <vbm:Route 
                                    id="route1"
                                    position="8.6821;50.1109;0;8.5622;50.0334;0"
                                    color="rgb(0,120,215)"
                                    linewidth="3"
                                    tooltip="Taxi Route"/>
                            </vbm:items>
                        </vbm:Routes>
                        
                    </vbm:AnalyticMap>
                    
                    <!-- Legend/Info -->
                    <HBox id="_IDGenHBox3" class="sapUiTinyMarginTop" justifyContent="SpaceAround">
                        <HBox id="_IDGenHBox4">
                            <core:Icon id="_IDGenIcon1" src="sap-icon://customer" color="green" class="sapUiTinyMarginEnd"/>
                            <Text id="_IDGenText5" text="Pickup Location"/>
                        </HBox>
                        <HBox id="_IDGenHBox5">
                            <core:Icon id="_IDGenIcon2" src="sap-icon://flight" color="red" class="sapUiTinyMarginEnd"/>
                            <Text id="_IDGenText6" text="Dropoff Location"/>
                        </HBox>
                    </HBox>
                    
                </VBox>
            </content>
        </Panel>
        
    </VBox>
</core:FragmentDefinition>