<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    
    <Dialog
        id="updateRideDialog"
        title="Update Taxi Ride"
        contentWidth="500px">
        <content>
            <f:SimpleForm id="_IDGenSimpleForm1"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                columnsXL="1"
                columnsL="1"
                columnsM="1">
                <f:content>
                    <Label id="_IDGenLabel10" text="Ride ID"/>
                    <Input id="_IDGenInput6"
                        value="{updateModel>/RideID}"
                        enabled="false"/>
                    
                    <Label id="_IDGenLabel17" text="Customer Name" required="true"/>
                    <Input id="_IDGenInput7"
                        value="{updateModel>/CustomerName}"
                        placeholder="Enter customer name"
                        liveChange="onNameChangeUpdate"
    valueState="{updateModel>/nameState}"
    valueStateText="{updateModel>/nameStateText}"/>
                    
                    <Label id="_IDGenLabel18" text="Pickup Address" required="true"/>
                    <Input id="_IDGenInput8"
                        value="{updateModel>/PickupAddress}"
                        placeholder="Enter pickup address"/>
                    
                    <Label id="_IDGenLabel19" text="Dropoff Address" required="true"/>
                    <Input id="_IDGenInput9"
                        value="{updateModel>/DropoffAddress}"
                        placeholder="Enter dropoff address"/>
                    
                    <Label id="_IDGenLabel20" text="Distance (km)" required="true"/>
                    <Input id="_IDGenInput10"
                        value="{updateModel>/DistanceKm}"
                        type="Number"
                        placeholder="Enter distance in km"/>
                    
                    <Label id="_IDGenLabel21" text="Payment Method" required="true"/>
                    <ComboBox id="_IDGenComboBox"
                        selectedKey="{updateModel>/PaymentMethod}"
                        placeholder="Select: CASH or CARD">
                        <items>
                            <core:Item id="_IDGenItem1" key="Cash" text="Cash"/>
                            <core:Item id="_IDGenItem2" key="Card" text="Card"/>
                        </items>
                    </ComboBox>
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button id="_IDGenButton5"
                text="Save"
                type="Emphasized"
                press="onSaveUpdate"/>
        </beginButton>
        <endButton>
            <Button id="_IDGenButton6"
                text="Cancel"
                press="onCancelUpdate"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>