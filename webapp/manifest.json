{
  "_version": "1.76.0",
  "sap.app": {
    "id": "taxi.manual.taxiui5",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.20.0",
      "toolsId": "e7ed9ac8-0463-49ba-b141-8a6cd2700860"
    },
    "dataSources": {
      "ZUI_TAXI_RIDE_AS_O2_VAN": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='ZUI_TAXI_RIDE_AS_O2_VAN',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/mainService/ZUI_TAXI_RIDE_AS_O2_VAN.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZUI_TAXI_RIDE_AS_O2/",
        "type": "OData",
        "settings": {
          "annotations": [
            "ZUI_TAXI_RIDE_AS_O2_VAN"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.139.3",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "taxi.manual.taxiui5.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "taxi.manual.taxiui5.view",
        "async": true,
        "viewPath": "taxi.manual.taxiui5.view"
      },
      "routes": [
        {
          "name": "RouteTaxiRide",
          "pattern": ":?query:",
          "target": [
            "TargetTaxiRide"
          ]
        },
        {
          "name": "RouteDetail",
          "pattern": "detail/{rideId}",
          "target": [
            "TargetDetail"
          ]
        },
        {
          "name": "RouteDashboard",
          "pattern": "dashboard",
          "target": [
            "TargetDashboard"
          ]
        }
      ],
      "targets": {
        "TargetTaxiRide": {
          "id": "TaxiRide",
          "name": "TaxiRide"
        },
        "TargetDetail": {
          "id": "idDetail",
          "name": "Detail"
        },
        "TargetDashboard": {
          "id": "Dashboard",
          "name": "Dashboard",
          "viewType": "XML",
          "viewPath": "taxi.manual.taxiui5.view",
          "viewName": "Dashboard",
          "controlAggregation": "pages"
        }
      }
    },
    "rootView": {
      "viewName": "taxi.manual.taxiui5.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
