<mvc:View
    controllerName="taxi.manual.taxiui5.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page
        id="detailPage"
        title="Taxi Ride Details"
        showNavButton="true"
        navButtonPress="onNavBack">
        <content>
            <ObjectHeader id="_IDGenObjectHeader"
                title="{detailModel>/RideID}"
                number="{detailModel>/TotalPrice}"
                numberUnit="{detailModel>/Currency}">
                <attributes>
                    <ObjectAttribute id="_IDGenObjectAttribute"
                        text="{detailModel>/CustomerName}"/>
                    <ObjectAttribute id="_IDGenObjectAttribute1"
                        text="{detailModel>/RideStatus}"/>
                </attributes>
            </ObjectHeader>

            <VBox id="_IDGenVBox" class="sapUiSmallMargin">
                <f:SimpleForm id="_IDGenSimpleForm"
                    editable="false"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="4"
                    labelSpanL="4"
                    labelSpanM="4"
                    labelSpanS="12"
                    columnsXL="2"
                    columnsL="2"
                    columnsM="1">
                    <f:content>
                        <core:Title id="_IDGenTitle1" text="Route Information"/>

                        <Label id="_IDGenLabel" text="Pickup Address"/>
                        <Text id="_IDGenText10" text="{detailModel>/PickupAddress}"/>

                        <Label id="_IDGenLabel1" text="Dropoff Address"/>
                        <Text id="_IDGenText11" text="{detailModel>/DropoffAddress}"/>

                        <Label id="_IDGenLabel2" text="Pickup Time"/>
                        <Text id="_IDGenText12" text="{ path: 'detailModel>/PickupDatetime',
              formatter: '.formatter.timeFromMs' }"/>

                        <Label id="_IDGenLabel3" text="Dropoff Time"/>
                        <Text id="_IDGenText13" text="{ path: 'detailModel>/DropoffDatetime',
              formatter: '.formatter.timeFromMs' }"/>

                        <Label id="_IDGenLabel4" text="Distance"/>
                        <ObjectNumber id="_IDGenObjectNumber2"
                            number="{detailModel>/DistanceKm}"
                            unit="km"
                            state="{= ${detailModel>/DistanceKm} > 20 ? 'Error' : 'Success' }"/>

                        <core:Title id="_IDGenTitle2" text="Payment Information"/>

                        <Label id="_IDGenLabel5" text="Base Fare"/>
                        <ObjectNumber id="_IDGenObjectNumber3"
                            number="{detailModel>/BaseFare}"
                            unit="{detailModel>/Currency}"/>

                        <Label id="_IDGenLabel6" text="Price per km"/>
                        <ObjectNumber id="_IDGenObjectNumber4"
                            number="{detailModel>/PricePerKm}"
                            unit="{detailModel>/Currency}"/>

                        <Label id="_IDGenLabel7" text="Total Price"/>
                        <ObjectNumber id="_IDGenObjectNumber5"
                            number="{detailModel>/TotalPrice}"
                            unit="{detailModel>/Currency}"
                            emphasized="true"/>

                        <Label id="_IDGenLabel8" text="Payment Method"/>
                        <HBox id="paymentMethodBox" alignItems="Center">
                            <core:Icon id="_IDGenIcon1" 
                                src="{= ${detailModel>/PaymentMethod} === 'Cash' ? 'sap-icon://money-bills' : 'sap-icon://credit-card' }"
                                size="2rem"
                                color="{= ${detailModel>/PaymentMethod} === 'Cash' ? '#2b7c2b' : '#0854a0' }"
                                class="sapUiTinyMarginEnd"/>
                            <Text id="_IDGenText14" text="{detailModel>/PaymentMethod}" class="sapUiMediumMarginBegin"/>
                        </HBox>

                        <core:Title id="_IDGenTitle3" text="Driver Information"/>

                        <Label id="_IDGenLabel9" text="Driver ID"/>
                        <Text id="_IDGenText15" text="{detailModel>/DriverID}"/>
                    </f:content>
                </f:SimpleForm>
            </VBox>
        </content>
        <footer>
            <Toolbar id="_IDGenToolbar">
                <ToolbarSpacer id="_IDGenToolbarSpacer2"/>
                <Button id="_IDGenButton"
                    text="Open in Google Maps"
                    type="Emphasized"
                    icon="sap-icon://map"
                    press="onOpenRouteInMaps"/>
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
